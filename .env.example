# Copiar como .env en el servidor. NO subir .env a git.

POSTGRES_DB=dasi
POSTGRES_USER=dasi
POSTGRES_PASSWORD=CambieEstaClaveSegura
# Mantener el usuario, la clave y la base iguales a POSTGRES_*.
# Si la clave tiene caracteres especiales, codifícala para URL.
DATABASE_URL=postgresql://dasi:CambieEstaClaveSegura@db:5432/dasi?schema=public

# projectId del firebaseConfig de Firebase Console
FIREBASE_PROJECT_ID=dasi-4a687

# Dominio público permitido por CORS
CORS_ORIGIN=https://dasi.uroosevelt.edu.pe

# true solo en el primer despliegue; luego false.
IMPORTAR_DATOS=true

# Reservado para pruebas locales. El compose de producción no publica
# puertos: Caddy central publica 80/443.
WEB_PORT=80
