generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * ═══════════════════════════════════════════════════════════════════════
 * ENUMS
 * ═══════════════════════════════════════════════════════════════════════
 */

enum EstadoProyecto {
  Pendiente
  Aprobado
  EnCurso
  Implementado
  EnRevision
  Completado
}

enum EstadoActividad {
  Pendiente
  Aprobado
  EnCurso
  Terminado
  EnRevision
  Completado
}

enum EstadoEvidencia {
  Pendiente
  EnRevision
  Aprobada
  Observada
}

enum EstadoObservacion {
  Abierta
  Respondida
  Resuelta
}

enum Prioridad {
  Alta
  Media
  Baja
}

enum EstadoUsuario {
  Activo
  Inactivo
}

enum ScopeRol {
  GLOBAL
  DEPENDENCIA
  PROPIO
  ASIGNADO
}

enum TipoAccionPermiso {
  Ver
  Crear
  Editar
  CambiarEstado
  Eliminar
  Aprobar
  Revisar
  Completar
  Observar
  Asignar
  Exportar
  Administrar
}

enum TipoDependencia {
  Oficina
  Escuela
  JGA
  Direccion
}

enum StorageProvider {
  local
  s3
  r2
  minio
}

enum EstadoWorkflow {
  Pendiente
  EnCurso
  Completado
}

enum TipoNotificacion {
  PROYECTO_CREADO
  PROYECTO_ASIGNADO
  ACTIVIDAD_ASIGNADA
  ACTIVIDAD_PROXIMO_VENCER
  ACTIVIDAD_VENCIDA
  PROYECTO_PROXIMO_VENCER
  PROYECTO_VENCIDO
  PROYECTO_ESTANCADO
  EVIDENCIA_PENDIENTE
  OBSERVACION_REGISTRADA
  ACTIVIDAD_PENDIENTE_REVISION
  PROYECTO_PENDIENTE_APROBACION
  PROYECTO_IMPLEMENTADO
  PROYECTO_COMPLETADO
  SISTEMA
}

enum TipoEventoCalendario {
  PROYECTO
  ACTIVIDAD
  PERSONAL
  REUNION
}

/**
 * ═══════════════════════════════════════════════════════════════════════
 * 1. ORGANIZACION
 * ═══════════════════════════════════════════════════════════════════════
 */

model Dependencia {
  id       String          @id @default(uuid()) @db.Uuid
  code     String          @unique
  nombre   String
  tipo     TipoDependencia
  director String
  activa   Boolean         @default(true)

  parent_id String?       @db.Uuid
  parent    Dependencia?  @relation("DependenciaJerarquia", fields: [parent_id], references: [id], onUpdate: Restrict, onDelete: SetNull)
  hijos     Dependencia[] @relation("DependenciaJerarquia")

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  usuario_dependencias       UsuarioDependencia[]
  usuarios                   Usuario[]
  proyectos                  Proyecto[]
  proyecto_dependencias      ProyectoDependencia[]
  proyecto_workflow          ProyectoWorkflow[]
  proyecto_responsabilidades ProyectoResponsabilidad[]

  @@index([tipo])
  @@index([activa])
  @@index([parent_id])
}

model Cargo {
  id          String  @id @default(uuid()) @db.Uuid
  nombre      String  @unique
  descripcion String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  usuarios       Usuario[]
  usuario_cargos UsuarioCargo[]
}

/**
 * ═══════════════════════════════════════════════════════════════════════
 * 2. SEGURIDAD Y ACCESO
 * ═══════════════════════════════════════════════════════════════════════
 */

model Usuario {
  id         String        @id @default(uuid()) @db.Uuid
  email      String        @unique
  nombre     String
  account    String        @unique
  initials   String?
  avatar_url String?
  estado     EstadoUsuario @default(Activo)

  dependencia_id String?      @db.Uuid
  dependencia    Dependencia? @relation(fields: [dependencia_id], references: [id], onUpdate: Restrict, onDelete: SetNull)

  cargo_id String? @db.Uuid
  cargo    Cargo?  @relation(fields: [cargo_id], references: [id], onUpdate: Restrict, onDelete: SetNull)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  usuario_dependencias UsuarioDependencia[]
  usuario_cargos       UsuarioCargo[]
  usuario_roles        UsuarioRol[]

  proyectos_creados      Proyecto[]                @relation("ProyectoCreadorOriginal")
  proyectos_owner        Proyecto[]                @relation("ProyectoOwner")
  proyectos_coordinados  Proyecto[]                @relation("ProyectoCoordinador")
  proyecto_equipo        ProyectoEquipo[]
  proyecto_workflow_resp ProyectoWorkflow[]
  proyecto_responsable   ProyectoResponsabilidad[]

  actividades_responsable Actividad[]         @relation("ActividadResponsable")
  actividades_creadas     Actividad[]         @relation("ActividadCreador")
  evidencias              Evidencia[]
  observaciones           Observacion[]
  archivos                Archivo[]
  historial               HistorialProyecto[]
  notificaciones          Notificacion[]
  eventos_calendario      EventoCalendario[]
  auditoria               Auditoria[]

  @@index([dependencia_id])
  @@index([cargo_id])
  @@index([estado])
}

model UsuarioDependencia {
  id             String  @id @default(uuid()) @db.Uuid
  usuario_id     String  @db.Uuid
  dependencia_id String  @db.Uuid
  es_principal   Boolean @default(false)

  usuario     Usuario     @relation(fields: [usuario_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  dependencia Dependencia @relation(fields: [dependencia_id], references: [id], onUpdate: Restrict, onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([usuario_id, dependencia_id])
  @@index([dependencia_id])
}

model UsuarioCargo {
  id         String @id @default(uuid()) @db.Uuid
  usuario_id String @db.Uuid
  cargo_id   String @db.Uuid

  usuario Usuario @relation(fields: [usuario_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  cargo   Cargo   @relation(fields: [cargo_id], references: [id], onUpdate: Restrict, onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([usuario_id, cargo_id])
  @@index([cargo_id])
}

model Rol {
  id          String   @id @default(uuid()) @db.Uuid
  nombre      String   @unique
  descripcion String?
  scope       ScopeRol @default(DEPENDENCIA)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  usuario_roles UsuarioRol[]
  rol_permisos  RolPermiso[]
}

model UsuarioRol {
  id         String @id @default(uuid()) @db.Uuid
  usuario_id String @db.Uuid
  rol_id     String @db.Uuid

  usuario Usuario @relation(fields: [usuario_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  rol     Rol     @relation(fields: [rol_id], references: [id], onUpdate: Restrict, onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([usuario_id, rol_id])
  @@index([rol_id])
}

model Modulo {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  nombre      String
  descripcion String?
  activo      Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  permisos Permiso[]

  @@index([activo])
}

model Permiso {
  id        String            @id @default(uuid()) @db.Uuid
  modulo_id String            @db.Uuid
  accion    TipoAccionPermiso

  modulo       Modulo       @relation(fields: [modulo_id], references: [id], onUpdate: Restrict, onDelete: Cascade)
  rol_permisos RolPermiso[]

  created_at DateTime @default(now())

  @@unique([modulo_id, accion])
  @@index([modulo_id])
}

model RolPermiso {
  id         String @id @default(uuid()) @db.Uuid
  rol_id     String @db.Uuid
  permiso_id String @db.Uuid

  rol     Rol     @relation(fields: [rol_id], references: [id], onUpdate: Restrict, onDelete: Cascade)
  permiso Permiso @relation(fields: [permiso_id], references: [id], onUpdate: Restrict, onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([rol_id, permiso_id])
  @@index([permiso_id])
}

/**
 * ═══════════════════════════════════════════════════════════════════════
 * 3. PROYECTOS
 * ═══════════════════════════════════════════════════════════════════════
 */

model Proyecto {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  nombre      String
  descripcion String?
  objetivo    String?

  owner_id String  @db.Uuid
  owner    Usuario @relation("ProyectoOwner", fields: [owner_id], references: [id], onUpdate: Restrict, onDelete: Restrict)

  coordinador_id String  @db.Uuid
  coordinador    Usuario @relation("ProyectoCoordinador", fields: [coordinador_id], references: [id], onUpdate: Restrict, onDelete: Restrict)

  created_by_id String  @db.Uuid
  created_by    Usuario @relation("ProyectoCreadorOriginal", fields: [created_by_id], references: [id], onUpdate: Restrict, onDelete: Restrict)

  dependencia_id String      @db.Uuid
  dependencia    Dependencia @relation(fields: [dependencia_id], references: [id], onUpdate: Restrict, onDelete: Restrict)

  prioridad Prioridad      @default(Media)
  estado    EstadoProyecto @default(Pendiente)
  riesgo    Boolean        @default(false)
  progreso  Int            @default(0)

  fecha_inicio       DateTime?
  fecha_fin_estimada DateTime?
  fecha_fin_real     DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  proyecto_dependencias      ProyectoDependencia[]
  proyecto_equipo            ProyectoEquipo[]
  proyecto_workflow          ProyectoWorkflow[]
  proyecto_responsabilidades ProyectoResponsabilidad[]
  actividades                Actividad[]
  evidencias                 Evidencia[]
  observaciones              Observacion[]
  historial                  HistorialProyecto[]
  notificaciones             Notificacion[]
  eventos_calendario         EventoCalendario[]

  @@index([owner_id])
  @@index([coordinador_id])
  @@index([created_by_id])
  @@index([dependencia_id])
  @@index([estado])
  @@index([prioridad])
  @@index([created_at])
}

model ProyectoDependencia {
  id             String @id @default(uuid()) @db.Uuid
  proyecto_id    String @db.Uuid
  dependencia_id String @db.Uuid

  proyecto    Proyecto    @relation(fields: [proyecto_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  dependencia Dependencia @relation(fields: [dependencia_id], references: [id], onUpdate: Restrict, onDelete: Restrict)

  created_at DateTime @default(now())

  @@unique([proyecto_id, dependencia_id])
  @@index([dependencia_id])
}

model ProyectoEquipo {
  id          String @id @default(uuid()) @db.Uuid
  proyecto_id String @db.Uuid
  usuario_id  String @db.Uuid

  proyecto Proyecto @relation(fields: [proyecto_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuario_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([proyecto_id, usuario_id])
  @@index([usuario_id])
}

model ProyectoWorkflow {
  id          String @id @default(uuid()) @db.Uuid
  proyecto_id String @db.Uuid
  etapa       String
  orden       Int

  estado EstadoWorkflow @default(Pendiente)

  dependencia_id String?      @db.Uuid
  dependencia    Dependencia? @relation(fields: [dependencia_id], references: [id], onUpdate: Restrict, onDelete: SetNull)

  responsable_id String?  @db.Uuid
  responsable    Usuario? @relation(fields: [responsable_id], references: [id], onUpdate: Restrict, onDelete: SetNull)

  accion_requerida String?

  started_at   DateTime?
  completed_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  proyecto Proyecto @relation(fields: [proyecto_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@unique([proyecto_id, etapa])
  @@index([proyecto_id])
  @@index([etapa])
  @@index([estado])
  @@index([orden])
}

model ProyectoResponsabilidad {
  id          String         @id @default(uuid()) @db.Uuid
  proyecto_id String         @db.Uuid
  etapa       EstadoProyecto

  dependencia_id String      @db.Uuid
  dependencia    Dependencia @relation(fields: [dependencia_id], references: [id], onUpdate: Restrict, onDelete: Restrict)

  responsable_id String?  @db.Uuid
  responsable    Usuario? @relation(fields: [responsable_id], references: [id], onUpdate: Restrict, onDelete: SetNull)

  accion     String
  habilitado Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  proyecto Proyecto @relation(fields: [proyecto_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@unique([proyecto_id, etapa])
  @@index([proyecto_id])
  @@index([dependencia_id])
  @@index([responsable_id])
}

/**
 * ═══════════════════════════════════════════════════════════════════════
 * 4. ACTIVIDADES
 * ═══════════════════════════════════════════════════════════════════════
 */

model Actividad {
  id          String  @id @default(uuid()) @db.Uuid
  titulo      String
  descripcion String?
  code        String?
  fase        String?

  proyecto_id String   @db.Uuid
  proyecto    Proyecto @relation(fields: [proyecto_id], references: [id], onUpdate: Restrict, onDelete: Cascade)

  responsable_id String  @db.Uuid
  responsable    Usuario @relation("ActividadResponsable", fields: [responsable_id], references: [id], onUpdate: Restrict, onDelete: Restrict)

  created_by_id String  @db.Uuid
  created_by    Usuario @relation("ActividadCreador", fields: [created_by_id], references: [id], onUpdate: Restrict, onDelete: Restrict)

  prioridad Prioridad       @default(Media)
  estado    EstadoActividad @default(Pendiente)
  progreso  Int             @default(0)

  fecha_inicio       DateTime?
  fecha_fin_estimada DateTime?
  fecha_fin_real     DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  evidencias         Evidencia[]
  observaciones      Observacion[]
  eventos_calendario EventoCalendario[]
  notificaciones     Notificacion[]

  @@index([proyecto_id, estado])
  @@index([responsable_id])
  @@index([created_by_id])
  @@index([prioridad])
  @@index([created_at])
}

/**
 * ═══════════════════════════════════════════════════════════════════════
 * 5. ARCHIVOS (Cloudflare R2)
 * ═══════════════════════════════════════════════════════════════════════
 */

model Archivo {
  id               String          @id @default(uuid()) @db.Uuid
  nombre_original  String
  nombre_storage   String          @unique
  extension        String
  mime_type        String
  size_bytes       BigInt
  storage_provider StorageProvider @default(r2)
  storage_key      String
  bucket           String
  checksum         String?
  cdn_url          String?

  usuario_id String  @db.Uuid
  usuario    Usuario @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, onDelete: Restrict)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  evidencias Evidencia[]

  @@index([usuario_id])
  @@index([storage_key])
  @@index([bucket])
  @@index([created_at])
}

/**
 * ═══════════════════════════════════════════════════════════════════════
 * 6. EVIDENCIAS
 * ═══════════════════════════════════════════════════════════════════════
 * CONVENCIÓN DE USO:
 * - actividad_id: siempre que la evidencia pertenezca a una actividad (caso más común).
 * El proyecto_id se infiere de la actividad padre.
 * - proyecto_id: solo para evidencias de nivel institucional sin actividad asociada.
 * - Ambos pueden establecerse simultáneamente para referencia directa.
 * - archivo_id: opcional permite evidencias de texto puro (sin archivo adjunto).
 * - La capa de aplicación DEBE garantizar que al menos uno de actividad_id o proyecto_id esté definido.
 */

model Evidencia {
  id          String  @id @default(uuid()) @db.Uuid
  nombre      String
  descripcion String?

  actividad_id String?    @db.Uuid
  actividad    Actividad? @relation(fields: [actividad_id], references: [id], onUpdate: Restrict, onDelete: SetNull)

  proyecto_id String?   @db.Uuid
  proyecto    Proyecto? @relation(fields: [proyecto_id], references: [id], onUpdate: Restrict, onDelete: Cascade)

  archivo_id String?  @db.Uuid
  archivo    Archivo? @relation(fields: [archivo_id], references: [id], onUpdate: Restrict, onDelete: SetNull)

  usuario_id String  @db.Uuid
  usuario    Usuario @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, onDelete: Restrict)

  estado EstadoEvidencia @default(Pendiente)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  observaciones Observacion[]

  @@index([actividad_id])
  @@index([proyecto_id])
  @@index([archivo_id])
  @@index([usuario_id])
  @@index([estado])
  @@index([created_at])
}

/**
 * ═══════════════════════════════════════════════════════════════════════
 * 7. OBSERVACIONES
 * ═══════════════════════════════════════════════════════════════════════
 * CONVENCIÓN DE USO:
 * - Vincular siempre a la entidad más específica disponible:
 * evidencia_id > actividad_id > proyecto_id
 * - parent_id permite hilos de discusión (respuestas encadenadas).
 * - La capa de aplicación DEBE garantizar que al menos uno de
 * evidencia_id, actividad_id o proyecto_id esté definido.
 * - Estado flujo: Abierta → Respondida → Resuelta
 */

model Observacion {
  id        String @id @default(uuid()) @db.Uuid
  contenido String

  evidencia_id String?    @db.Uuid
  evidencia    Evidencia? @relation(fields: [evidencia_id], references: [id], onUpdate: Restrict, onDelete: SetNull)

  actividad_id String?    @db.Uuid
  actividad    Actividad? @relation(fields: [actividad_id], references: [id], onUpdate: Restrict, onDelete: SetNull)

  proyecto_id String?   @db.Uuid
  proyecto    Proyecto? @relation(fields: [proyecto_id], references: [id], onUpdate: Restrict, onDelete: Cascade)

  usuario_id String  @db.Uuid
  usuario    Usuario @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, onDelete: Restrict)

  parent_id String?       @db.Uuid
  parent    Observacion?  @relation("ObservacionHilo", fields: [parent_id], references: [id], onUpdate: Restrict, onDelete: SetNull)
  replies   Observacion[] @relation("ObservacionHilo")

  estado EstadoObservacion @default(Abierta)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@index([evidencia_id])
  @@index([actividad_id])
  @@index([proyecto_id])
  @@index([usuario_id])
  @@index([parent_id])
  @@index([estado])
  @@index([created_at])
}

/**
 * ═══════════════════════════════════════════════════════════════════════
 * 8. HISTORIAL
 * ═══════════════════════════════════════════════════════════════════════
 */

model HistorialProyecto {
  id          String @id @default(uuid()) @db.Uuid
  proyecto_id String @db.Uuid
  usuario_id  String @db.Uuid

  estado_anterior EstadoProyecto?
  estado_nuevo    EstadoProyecto

  accion     String
  comentario String?

  proyecto Proyecto @relation(fields: [proyecto_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, onDelete: Restrict)

  created_at DateTime @default(now())

  @@index([proyecto_id, created_at])
  @@index([usuario_id])
  @@index([estado_nuevo])
}

/**
 * ═══════════════════════════════════════════════════════════════════════
 * 9. NOTIFICACIONES
 * ═══════════════════════════════════════════════════════════════════════
 */

model Notificacion {
  id         String           @id @default(uuid()) @db.Uuid
  usuario_id String           @db.Uuid
  titulo     String
  mensaje    String
  tipo       TipoNotificacion @default(SISTEMA)
  leida      Boolean          @default(false)

  proyecto_id String?   @db.Uuid
  proyecto    Proyecto? @relation(fields: [proyecto_id], references: [id], onUpdate: Restrict, onDelete: SetNull)

  actividad_id String?    @db.Uuid
  actividad    Actividad? @relation(fields: [actividad_id], references: [id], onUpdate: Restrict, onDelete: SetNull)

  usuario Usuario @relation(fields: [usuario_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  created_at DateTime @default(now())

  @@index([usuario_id])
  @@index([leida])
  @@index([tipo])
  @@index([created_at])
  @@index([usuario_id, leida])
}

/**
 * ═══════════════════════════════════════════════════════════════════════
 * 10. CALENDARIO
 * ═══════════════════════════════════════════════════════════════════════
 */

model EventoCalendario {
  id           String               @id @default(uuid()) @db.Uuid
  titulo       String
  descripcion  String?
  fecha_inicio DateTime
  fecha_fin    DateTime
  todo_dia     Boolean              @default(false)
  color        String?
  tipo         TipoEventoCalendario @default(PERSONAL)

  usuario_id String  @db.Uuid
  usuario    Usuario @relation(fields: [usuario_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  proyecto_id String?   @db.Uuid
  proyecto    Proyecto? @relation(fields: [proyecto_id], references: [id], onUpdate: Restrict, onDelete: SetNull)

  actividad_id String?    @db.Uuid
  actividad    Actividad? @relation(fields: [actividad_id], references: [id], onUpdate: Restrict, onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([usuario_id])
  @@index([fecha_inicio])
  @@index([fecha_fin])
  @@index([proyecto_id])
  @@index([actividad_id])
  @@index([tipo])
}

/**
 * ═══════════════════════════════════════════════════════════════════════
 * 11. AUDITORIA
 * ═══════════════════════════════════════════════════════════════════════
 */

model Auditoria {
  id         String   @id @default(uuid()) @db.Uuid
  usuario_id String?  @db.Uuid
  usuario    Usuario? @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, onDelete: SetNull)

  accion      String
  modulo      String
  entidad     String
  entidad_id  String?
  descripcion String?
  ip_address  String?
  user_agent  String?
  metadata    Json?

  created_at DateTime @default(now())

  @@index([usuario_id])
  @@index([modulo])
  @@index([entidad, entidad_id])
  @@index([created_at])
}

/**
 * ═══════════════════════════════════════════════════════════════════════
 * 12. CONFIGURACIONES
 * ═══════════════════════════════════════════════════════════════════════
 */

model Configuracion {
  id          String  @id @default(uuid()) @db.Uuid
  clave       String  @unique
  valor       String
  descripcion String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
