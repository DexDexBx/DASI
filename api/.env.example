DATABASE_URL="postgresql://postgres:CLAVE_LOCAL@localhost:5432/dasi?schema=public"

# Servidor
PORT=3000
CORS_ORIGIN="http://localhost:4200"

# Firebase Authentication (solo Google). Es el "projectId" del firebaseConfig.
# No se necesita clave privada: la verificación usa las claves públicas de Google.
FIREBASE_PROJECT_ID=""

# Administrador inicial (usar solo al ejecutar prisma/create-admin.mjs).
# ADMIN_EMAIL debe ser la cuenta de Google con la que ingresará.
ADMIN_NOMBRE=""
ADMIN_EMAIL=""
ADMIN_ACCOUNT=""
ADMIN_DEPENDENCIA_CODE=""
ADMIN_CARGO=""
